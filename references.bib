    chapter = {Correspondence},
    title = {Environmental temperature and relative humidity influence exhaled breath condensate {pH}},
    volume = {31},
    issn = {0903-1936, 1399-3003},
    url = {https://publications.ersnet.org/content/erj/31/2/474},
    doi = {10.1183/09031936.00128007},
    language = {en},
    number = {2},
